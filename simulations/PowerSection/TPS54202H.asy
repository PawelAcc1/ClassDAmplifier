Version 4
SymbolType CELL
RECTANGLE Normal 80 48 -79 48
RECTANGLE Normal -80 -96 80 48
TEXT -80 64 Left 2 TPS54202HD
SYMATTR Prefix X
SYMATTR Value TPS54202H_TRANS
SYMATTR SpiceModel TPS54202H_TRANS
SYMATTR ModelFile ../libraries/poprawiony_model.lib
PIN 80 -80 RIGHT 8
PINATTR PinName BOOT
PINATTR SpiceOrder 1
PIN -80 16 LEFT 8
PINATTR PinName EN
PINATTR SpiceOrder 2
PIN 80 32 RIGHT 8
PINATTR PinName GND
PINATTR SpiceOrder 3
PIN 80 -48 RIGHT 8
PINATTR PinName PH
PINATTR SpiceOrder 4
PIN -80 -64 LEFT 8
PINATTR PinName VIN
PINATTR SpiceOrder 5
PIN 80 0 RIGHT 8
PINATTR PinName VSENS
PINATTR SpiceOrder 6
